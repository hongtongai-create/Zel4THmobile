# ---------- gateway ----------
# Shared secret for the board <=> gateway WebSocket. Change it.
GATEWAY_TOKEN=change-me-to-a-long-random-string
PORT=8787
HOST=0.0.0.0

# ---------- agent ----------
# Optional: which model starts a new session (provider:model)
# DEFAULT_MODEL=openai:gpt-4o-mini
MAX_ITERATIONS=8
DATA_DIR=data
LOG_LEVEL=info

# Estimated spend per model, in USD per 1M tokens: "input/output".
# Semicolon separated; supports an exact `provider:model`, a `provider:*` default,
# and a global `*` fallback. Turns without a price log cost=n/a.
# MODEL_PRICES=custom:nvidia/nemotron-3-ultra-550b-a55b=0.20/0.60;custom:*=0.10/0.30;*=1/3

# ---------- models (one or more providers) ----------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4.1-mini,gpt-4o-mini,gpt-4o

OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=openai/gpt-4.1-mini,anthropic/claude-sonnet-4,google/gemini-2.5-flash

# Local models (Ollama exposes an OpenAI-compatible endpoint)
# OLLAMA_ENABLED=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODELS=llama3.1,qwen2.5:7b

# Any other OpenAI-compatible endpoint (vLLM, Groq, Freebuff paid API, ...)
# LLM_LABEL=Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODELS=llama-3.3-70b-versatile

# ---------- extensions ----------
# skills/<name>/SKILL.md, plugins/<name>/, mcp.json live here. Relative to the project root.
# EXTENSIONS_DIR=extensions
# clawhub registry index (https URL, file: URL or local path). `off` disables installing.
# CLAWHUB_URL=https://raw.githubusercontent.com/hongtongai-create/Zel4THmobile/main/clawhub/index.json
# Can an agent change extensions itself? confirm (default) = queue every
# install/remove/reload for approval, allow = run directly, deny = never.
# Pending requests go to the board AND to the allowed Telegram chats / LINE sources;
# there, reply `approvals`, `approve <id>` or `reject <id>`.
# EXTENSIONS_AGENT_WRITES=confirm
# Let an extension tool shadow an existing tool name. Off keeps built-ins safe.
# EXTENSIONS_ALLOW_TOOL_OVERRIDE=0

# ---------- telegram ----------
# TELEGRAM_BOT_TOKEN=123456:AA...
# Comma separated numeric chat ids allowed to talk to the agent. Empty = nobody.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# ---------- LINE Messaging API ----------
# LINE Developers console -> your channel -> Messaging API.
# Requires an HTTPS webhook URL (put the gateway behind a tunnel/reverse proxy;
# do not expose the phone directly). The webhook path is signature-checked.
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# Comma separated user/group/room ids allowed to talk to the agent. Empty = nobody.
# LINE_ALLOWED_SOURCE_IDS=U1234567890abcdef
# Which office agent answers LINE (id from data/agents.json). Empty = main/default.
# LINE_AGENT_ID=main
# LINE_WEBHOOK_PATH=/webhooks/line

# ---------- facebook ----------
# FACEBOOK_PAGE_ID=1234567890
# FACEBOOK_PAGE_ACCESS_TOKEN=EAAB...
# FACEBOOK_PAGE_NAME=My Page
# FACEBOOK_GRAPH_VERSION=v21.0
# FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com
